# =========================
# AI
# =========================

GEMINI_API_KEY=

GEMINI_MODEL=gemini-3.8-flash
GEMINI_EMBEDDING_MODEL=text-embedding-004
GEMINI_EMBEDDING_DIM=768

# Provider abstraction (Phase 15). MVP ships with "gemini" only.
AI_PROVIDER=gemini

# =========================
# DATABASE
# =========================

POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=workwell
POSTGRES_USER=workwell
POSTGRES_PASSWORD=workwell

# =========================
# REDIS
# =========================

REDIS_URL=redis://redis:6379/0

# =========================
# APPLICATION
# =========================

APP_ENV=development
APP_SECRET_KEY=

JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

CORS_ORIGINS=http://localhost:3000

BACKEND_PORT=8000
FRONTEND_PORT=3000
VITE_API_BASE_URL=http://localhost:8000

# =========================
# PRIVACY
# =========================

RAW_TELEMETRY_STORAGE=false
KEYBOARD_CONTENT_STORAGE=false
WEBCAM_COLLECTION=false
AUDIO_RECORDING=false
