# =========================
# AI
# =========================

GEMINI_API_KEY=

GEMINI_MODEL=gemini-3.8-flash
# Comma-separated; tried in order when a model has spent its free-tier quota.
GEMINI_FALLBACK_MODELS=gemini-3.7-flash,gemini-3.5-flash-lite
# Seconds before a stalled model is skipped for the next one.
GEMINI_TIMEOUT_SECONDS=20
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
GEMINI_EMBEDDING_DIM=768

# Provider abstraction (Phase 15). MVP ships with "gemini" only.
AI_PROVIDER=gemini

# Pacing, sized for a free tier. The budget is shared across the API and
# the worker via Redis, so this is the whole allowance, not per process.
# Raise it to match your plan; a throttled sweep still finishes, it just
# takes longer, and nothing degrades to fallback text on the way.
LLM_REQUESTS_PER_MINUTE=10
LLM_MAX_RETRIES=3
LLM_RETRY_BASE_SECONDS=2.0
LLM_MAX_WAIT_SECONDS=120

# =========================
# DATABASE
# =========================

POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=workwell
POSTGRES_USER=workwell
POSTGRES_PASSWORD=workwell

# =========================
# REDIS
# =========================

REDIS_URL=redis://redis:6379/0

# =========================
# APPLICATION
# =========================

APP_ENV=development

# Presentation mode: employees sign in with their email and any non-empty
# password; HR/manager and wellness portals accept any work email. The
# employee dataset is imported on first start. Set false for real use.
DEMO_MODE=true
APP_SECRET_KEY=

JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

CORS_ORIGINS=http://localhost:3300,http://127.0.0.1:3300

BACKEND_PORT=8000
FRONTEND_PORT=3300
# Backend URL the frontend calls, baked in at build time.
VITE_API_URL=http://localhost:8000

# =========================
# BACKGROUND WORKER
# =========================

# The worker is what makes this an early-warning system rather than an
# on-demand report: it analyses every consenting employee once a day
# instead of waiting for someone to open the assistant.
WORKER_CONCURRENCY=2

# The worker's own Prometheus scrape target. Job counts and durations are
# recorded in-process, so without this nothing ever exposes them.
WORKER_METRICS_PORT=9100
JOB_LEASE_SECONDS=300
JOB_MAX_ATTEMPTS=3

# Hour (UTC) for the daily sweep. After most timezones' working day.
DAILY_ANALYSIS_HOUR_UTC=2

# How old a stored analysis may be before a chat message queues a refresh.
ANALYSIS_MAX_AGE_HOURS=24

# Re-analyse when new telemetry lands rather than only on the daily sweep,
# deduplicated to one run per employee per hour. Set false to hold model
# spend to exactly one analysis per employee per day.
REANALYSE_ON_INGEST=true

# Compute an analysis inline when no worker is running. Right for a
# single-process pilot; set false in production, where the worker container
# runs the same jobs off the request path.
INLINE_ANALYSIS_FALLBACK=true

# =========================
# NOTIFICATIONS
# =========================

# none | log | smtp | webhook. Defaults to log so a fresh install never
# emails staff before an admin has chosen to. Whatever the channel, the
# message says only that something is waiting - never what - because work
# email is not a private channel.
NOTIFICATION_CHANNEL=log

# Where the "open your dashboard" link points.
APP_BASE_URL=http://localhost:3300

SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_STARTTLS=true

NOTIFICATION_WEBHOOK_URL=

# =========================
# DATABASE POOL
# =========================

# Keep (DB_POOL_SIZE + DB_MAX_OVERFLOW) x replicas under Postgres's
# max_connections, or new replicas fail to connect under load.
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=5
DB_POOL_RECYCLE_SECONDS=1800

# =========================
# PRIVACY
# =========================

RAW_TELEMETRY_STORAGE=false
KEYBOARD_CONTENT_STORAGE=false
WEBCAM_COLLECTION=false
AUDIO_RECORDING=false

# ---------------------------------------------------------------------------
# Google Calendar (employee signs in with Google from the Privacy Centre).
# From an OAuth client in Google Cloud Console (Desktop or Web type), with the
# Calendar API enabled. Either set the id/secret, or point
# GOOGLE_CLIENT_SECRET_FILE at the downloaded client JSON.
# ---------------------------------------------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CLIENT_SECRET_FILE=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:8000/integrations/google/callback
