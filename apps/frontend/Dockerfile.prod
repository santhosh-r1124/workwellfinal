# Multi-stage: build the static bundle, then serve it from nginx. The dev
# Dockerfile runs the Vite dev server instead, which must never be used in
# production (no minification, source maps exposed, HMR websocket open).
FROM node:22-slim AS build

WORKDIR /app

COPY package.json ./
RUN npm install

COPY . .

# Vite inlines env vars at build time, so the API URL has to be supplied
# here rather than at container start.
ARG VITE_API_BASE_URL
ENV VITE_API_BASE_URL=$VITE_API_BASE_URL
RUN npm run build

FROM nginx:1.27-alpine

COPY --from=build /app/dist /usr/share/nginx/html
COPY nginx.conf /etc/nginx/conf.d/default.conf

EXPOSE 8080

CMD ["nginx", "-g", "daemon off;"]
